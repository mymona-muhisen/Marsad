APP_NAME=Marsad
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Where the React SPA is served. Human-facing links (the counterparty join
# deep link sent by SMS) are built from this, not APP_URL.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marsad
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production/staging target is redis (CLAUDE.md); local dev falls back to the
# database driver because no Redis server ships with this dev environment
# (see DECISIONS.md). Set to redis once REDIS_* below points at a real server.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SmsGateway adapter driver (CLAUDE.md rule #4). Only "log" exists today.
# External-dependency adapters (CLAUDE.md rule #4). Each defaults to a
# manual mode that works without the vendor being wired up.
SMS_DRIVER=log
POLICY_VERIFIER_DRIVER=manual
PAYMENT_RECORDER_DRIVER=record_only
SMS_LOG_CHANNEL=stack

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_MAX_PER_WINDOW=3
OTP_REQUEST_WINDOW_MINUTES=10

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
